# Application Configuration
APP_NAME=AI Microservice
APP_ENV=development
PORT=8000
DEBUG=true
LOG_LEVEL=INFO

# Security / CORS
ALLOWED_ORIGINS=["http://localhost:8080","http://localhost:5000"]
INTERNAL_API_KEY=secret-internal-api-key

# LLM Provider Configuration ("groq" or "gemini")
LLM_PROVIDER=groq

# Groq AI Provider (Free tier model from Groq Cloud - https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=30

# Legacy Gemini AI Provider
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=30
